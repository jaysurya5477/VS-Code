<mvc:View controllerName="com.sap.zeuser.controller.main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form" height="100%" width="100%">
    <Page id="_IDGenPage1" title="{i18n>title}" showHeader="false" class="sapUiNoContentPadding" enableScrolling="true">
        <FlexBox id="_IDGenFlexbox" width="100%" height="100%" justifyContent="Center" alignItems="Center">
            <!-- Left Form Box - will center when right box is hidden -->
            <VBox id="FormBox" width="50%" class="formBoxResponsive" justifyContent="Center" alignItems="Center">

                <FlexBox id="_IDGenSimpleForm" class="loginBox" width="400px" height="auto" direction="Column" alignItems="Stretch" justifyContent="Start">
                   
                    <Label id="_IDGenLabel" text="{i18n>username}" />
                    <Input id="usernameInput" value="{/username}" change="onUsernameChange"/>

                    <Label id="_IDGenLabel1" text="{i18n>password}" />
                    <Input id="passwordInput" type="Password" value="{/password}" valueHelpIconSrc="sap-icon://show" showValueHelp="true" valueHelpRequest="onTogglePassword" change="onPasswordChange"/>

                    <Label id="_IDGenLabel2" text="{i18n>repeatpassword}" />
                    <Input id="repeatPasswordInput" type="Password" value="{/repeatpassword}" valueHelpIconSrc="sap-icon://show" showValueHelp="true" valueHelpRequest="onTogglePassword" change="onRepeatPasswordChange"/>

                    <Label id="_IDGenLabel3" text="{i18n>email}" />
                    <Input id="emailInput" type="Email" value="{/email}" change="onEmailChange"/>

                    <Label id="_IDGenLabel4" text="{i18n>phone}" />
                    <FlexBox id="_IDGenHBox1" alignItems="Center" width="100%" justifyContent="SpaceBetween">
                        <items>
                            <Input id="phoneInput" type="Tel" value="{/phone}" liveChange="onPhoneLiveChange" change="onPhoneChange" width="100%">
                                <layoutData>
                                    <FlexItemData id="_IDGenFlexItemData" growFactor="1" />
                                </layoutData>
                            </Input>
                            <Button id="sendOtpButton" text="Send OTP" visible="false" press="onSendOtp" class="sapUiTinyMarginBegin"/>
                        </items>
                    </FlexBox>

                    <Button id="registerButton" text="Register" type="Emphasized" class="sapUiSmallMarginTop" width="100%" press="onRegister"/>
                    <VBox id="messageVBox" width="100%">
                        <MessageStrip id="messageStrip" visible="false" showIcon="true" showCloseButton="true" class="sapUiNoMargin"/>
                    </VBox>
                </FlexBox>
            </VBox>

            <!-- Right Logo Box - will hide on smaller screens -->
            <VBox id="LogoBox" width="50%" height="100%" justifyContent="Center" alignItems="Center" class="logoBoxResponsive">
                <Image id="logoImage" src="{imgModel>/logoPath}" width="100%" height="auto" densityAware="false" class="sapUiResponsiveMargin" />
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>